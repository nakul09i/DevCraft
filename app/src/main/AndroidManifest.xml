<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- Re-arm due-date alarms after reboot; Android drops them all on restart. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!--
        Channel B: capture incoming customer SMS as order messages. Requested on
        demand from the dashboard, never at startup. Works without being the
        default SMS app: SMS_RECEIVED is observable by any app holding this
        permission. Unrelated to Firebase phone OTP, which is authentication.
        NOTE: this is a Play Store restricted permission - see docs/SMS_INGESTION.md.
    -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />

    <application
        android:name=".DevCraftApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="DevCraft"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.DevCraft">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.DevCraft.Launch">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- Ingest shared text from WhatsApp, SMS, or any external messaging app -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name=".alerts.OrderDueReceiver"
            android:exported="false" />

        <!--
            exported=true is required: this receives a system broadcast.
            android:permission ensures only the OS can deliver it, so another
            app cannot forge a fake incoming SMS into the order inbox.
        -->
        <!--
            Reads messaging notifications so orders can be captured without a
            manual share. Requires the user to grant "Notification access" in
            system settings; Android never grants this silently. Only an
            allow-list of messaging apps is read - see docs/SMS_INGESTION.md.
        -->
        <service
            android:name=".notifications.DevCraftNotificationListener"
            android:exported="false"
            android:label="DevCraft order capture"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".sms.SmsReceiver"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="500">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <receiver
            android:name=".alerts.BootReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>
    </application>

</manifest>
